{
  "expo": {
    "name": "ALP Platform",
    "slug": "alp-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "alp",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stanparaclete.alp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan documents for ALP records",
        "NSPhotoLibraryUsageDescription": "Attach photos to student records",
        "NSFaceIDUsageDescription": "Use Face ID to securely log in"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.stanparaclete.alp",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "eas": { "projectId": "YOUR_EAS_PROJECT_ID_FROM_EXPO_DEV" }
    },
    "owner": "stanparaclete",
    "description": "Accelerated Learning Programs for every student. AI-powered tools, global compliance, family collaboration. Built by Stan Paraclete.",
    "primaryColor": "#7C3AED"
  }
}
