{
  "cli": { "version": ">= 9.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "ios":     { "credentialsSource": "remote" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "production" },
      "ios":     { "language": "en-US" }
    }
  }
}
