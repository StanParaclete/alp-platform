{
  "name": "alp-desktop",
  "productName": "ALP",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "description": "Accelerated Learning Plan desktop client",
  "author": { "name": "Stan Paraclete", "url": "https://www.stanparaclete.com" },
  "main": "src/main.cjs",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "prestart": "npm run assets",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "prepack": "npm run assets && npm test",
    "pack": "electron-builder --dir --publish never",
    "predist": "npm run assets && npm test",
    "dist": "electron-builder --publish never"
  },
  "dependencies": { "electron-updater": "6.8.9" },
  "devDependencies": { "electron": "44.3.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "com.growwithalp.desktop",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["src/**", "assets/**", "release-config.json", "package.json"],
    "artifactName": "ALP-${version}-${os}-${arch}.${ext}",
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.education", "icon": "assets/icon.png", "hardenedRuntime": true },
    "win": { "target": ["nsis"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "category": "Education", "icon": "assets/icon.png" },
    "publish": [{ "provider": "github", "owner": "StanParaclete", "repo": "alp-platform", "releaseType": "draft" }]
  }
}
