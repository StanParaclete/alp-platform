# ═══════════════════════════════════════════════
# ALP Platform — Environment Variables
# This file is copied to .env by setup.sh
# ═══════════════════════════════════════════════

# DATABASE — replace 'hamzaobi' with YOUR Mac username
DATABASE_URL="postgresql://hamzaobi@localhost:5432/alp_db"

# JWT SECRETS
JWT_SECRET="alp-jwt-secret-change-in-production-2026"
JWT_REFRESH_SECRET="alp-refresh-secret-change-in-production-2026"

# SERVER
PORT=4000
NODE_ENV=development

# ANTHROPIC API KEY — get from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# URLS
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
DATABASE_URL_FORCED=true
