{
  "name": "@alp/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node scripts/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:integration": "node scripts/check-integration.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.4",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.9",
    "pg": "8.23.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
